from flask import Flask, request, jsonify

app = Flask(__name__)

dogs = []
bite_reports = []


@app.route("/")
def home():
    return jsonify({
        "project": "RabiesGuard",
        "status": "Backend is running"
    })


# Add dog
@app.route("/dogs", methods=["POST"])
def add_dog():

    data = request.json

    dog = {
        "rfid": data.get("rfid"),
        "qr_code": data.get("qr_code"),
        "ward": data.get("ward"),
        "vaccinated": data.get("vaccinated", False),
        "sterilized": data.get("sterilized", False),
        "location": data.get("location")
    }

    dogs.append(dog)

    return jsonify({
        "message": "Dog record added successfully",
        "dog": dog
    }), 201


# Get all dogs
@app.route("/dogs", methods=["GET"])
def get_dogs():
    return jsonify(dogs)


# Submit bite report
@app.route("/bite-report", methods=["POST"])
def bite_report():

    data = request.json

    report = {
        "name": data.get("name"),
        "phone": data.get("phone"),
        "dog_id": data.get("dog_id"),
        "location": data.get("location"),
        "date": data.get("date")
    }

    bite_reports.append(report)

    return jsonify({
        "message": "Bite report submitted successfully",
        "report": report
    }), 201


# Get bite reports
@app.route("/bite-reports", methods=["GET"])
def get_bite_reports():
    return jsonify(bite_reports)


if __name__ == "__main__":
    app.run(debug=True)